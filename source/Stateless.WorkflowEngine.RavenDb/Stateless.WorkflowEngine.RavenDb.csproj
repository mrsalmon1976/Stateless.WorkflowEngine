<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>5.1.0</Version>
    <AssemblyVersion>5.1.0</AssemblyVersion>
    <FileVersion>5.1.0</FileVersion>
    <Authors>Matt Salmon</Authors>
    <Title>Stateless.WorkflowEngine.RavenDb</Title>
    <Description>Assembly required for the persistence of workflows to a RavenDb database</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrsalmon1976/Stateless.WorkflowEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrsalmon1976/Stateless.WorkflowEngine.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>workflow;workflow-engine;stateless;state-machine;ravendb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RavenDB.Client" Version="7.2.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stateless.WorkflowEngine\Stateless.WorkflowEngine.csproj" />
  </ItemGroup>
</Project>
