<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>5.1.0</Version>
    <AssemblyVersion>5.1.0</AssemblyVersion>
    <FileVersion>5.1.0</FileVersion>
    <Authors>Matt Salmon</Authors>
    <Title>Stateless.WorkflowEngine</Title>
    <Description>A workflow wrapper for the Stateless library that includes persistence, retries, and workflow suspension.</Description>
    <Copyright>Copyright (c) 2014 mrsalmon1976</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrsalmon1976/Stateless.WorkflowEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrsalmon1976/Stateless.WorkflowEngine.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>workflow;workflow-engine;stateless;state-machine</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Stateless" Version="5.20.1" />
  </ItemGroup>
</Project>