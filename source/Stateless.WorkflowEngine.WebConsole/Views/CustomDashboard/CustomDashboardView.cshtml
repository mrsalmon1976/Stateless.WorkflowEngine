@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<Stateless.WorkflowEngine.WebConsole.ViewModels.CustomDashboard.CustomDashboardViewModel>
@using Stateless.WorkflowEngine.WebConsole.Navigation
@using Stateless.WorkflowEngine.WebConsole.BLL.Security
@{
    Layout = "Views/Layouts/MainLayout.cshtml";
    ViewBag.Title = "Stateless.WorkflowEngine Console :: Custom Dashboards";
}
<!-- Tools -->
<section id="tools">
    <ul class="breadcrumb" id="breadcrumb">
        <li class="title">Custom Dashboards</li>
    </ul>
    <div id="toolbar">
        <div class="btn-group">
            @if (Model.CurrentUserCanAdd)
            {
                <a id="btn-add-dashboard" class="btn" data-toggle="toolbar-tooltip" href="#" title="Add dashboard">
                    <i class="fa fa-plus"></i>
                </a>
            }
        </div>
    </div>
</section>
<!-- Content -->
<div id="content">
    <div id="pnl-loading">
        <i class="pull-left fa fa-circle-o-notch fa-spin fa-2x fa-fw"></i>
        <h4 class="pull-left">Loading dashboards...</h4>
    </div>
    <div id="pnl-dashboards">
    </div>
</div>
<div class="modal fade" id="dlg-dashboard" tabindex="-1" role="dialog" aria-labelledby="dlg-dashboard-title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="dlg-dashboard-title">Add dashboard</h4>
            </div>
            <div class="modal-body">
                <div id="dashboard-msg-error" class="alert alert-danger hidden" role="alert">An error occurred.</div>
                <form id="form-dashboard" class="form-horizontal" role="form" method="post">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Name</label>
                        <div class="col-sm-9">
                            <input id="txt-dashboard-name" class="form-control" placeholder="Dashboard name" name="name" type="text" value="">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Connections</label>
                        <div class="col-sm-9">
                            <select id="sel-connections" multiple="multiple" name="connectionIds" style="width:100%;">
                                @foreach (var conn in Model.Connections)
                                {
                                    <option value="@conn.Id">@conn.Database (@conn.Host:@conn.Port)</option>
                                }
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <i id="dashboard-spinner" class="hide fa fa-circle-o-notch fa-spin fa-lg fa-fw pull-right"></i>
                <input type="hidden" id="hid-dashboard-id" name="id" value="" />
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button id="btn-submit-dashboard" type="button" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>
