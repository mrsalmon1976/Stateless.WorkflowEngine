<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>5.1.0</Version>
    <Authors>Matt Salmon</Authors>
    <AssemblyName>Stateless.WorkflowEngine.WebConsole</AssemblyName>
    <RootNamespace>Stateless.WorkflowEngine.WebConsole</RootNamespace>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ClientAppPath>..\Stateless.WorkflowEngine.WebConsole.Client\</ClientAppPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Stateless.WorkflowEngine.WebConsole" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.5.0" />
    <PackageReference Include="System.IO.Abstractions" Version="21.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stateless.WorkflowEngine\Stateless.WorkflowEngine.csproj" />
    <ProjectReference Include="..\Stateless.WorkflowEngine.MongoDb\Stateless.WorkflowEngine.MongoDb.csproj" />
    <ProjectReference Include="..\Stateless.WorkflowEngine.RavenDb\Stateless.WorkflowEngine.RavenDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Update.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="install-service.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Builds the Vue client into wwwroot before publishing.  Pass -p:SkipClientBuild=true when the client
    has already been built (e.g. the Docker image builds it in a separate node stage).
  -->
  <Target Name="BuildClient" BeforeTargets="PrepareForPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppPath)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppPath)" />
    <ItemGroup>
      <_ClientDistFiles Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(_ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(_ClientDistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
