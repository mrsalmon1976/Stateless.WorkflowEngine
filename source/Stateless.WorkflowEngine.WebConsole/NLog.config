<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <target name="logfile" type="File" fileName="${basedir}/logs/${date:format=yyyy-MM-dd}.log" layout="${longdate}|${level}|${logger}|${message}|${exception:format=ToString}" />
    <target name="console" type="Console" layout="${longdate}|${level}|${logger}|${message}|${exception:format=ToString}" />
  </targets>
  <rules>
    <!-- skip noisy framework logs below warning -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="logfile,console" />
  </rules>
</nlog>
