<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- a packages folder of its own, so publish.ps1 can replace a re-pushed version without clearing the global cache -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <!-- ignore machine/user feeds so restore is the same everywhere -->
    <clear />
    <!-- local feed created by a non-production run of deployment/publish.ps1 -->
    <add key="NugetPackageTest" value="..\NugetPackageTest" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- the packages under test only ever come from the local feed, never nuget.org -->
    <packageSource key="NugetPackageTest">
      <package pattern="Stateless.WorkflowEngine*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
