<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- floating versions resolve to the newest package (pre-releases included) in the local feed created by a
       non-production run of deployment/publish.ps1 - see ..\nuget.config -->
  <ItemGroup>
    <PackageReference Include="Stateless.WorkflowEngine" Version="*-*" />
    <PackageReference Include="Stateless.WorkflowEngine.MongoDb" Version="*-*" />
  </ItemGroup>

</Project>
